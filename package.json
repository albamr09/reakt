{
	"name": "reakt",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"build": "NODE_ENV=production tsup",
		"build:dev": "tsup",
		"lint:check": "biome check src",
		"lint:format": "biome format --write src",
		"lint:fix": "biome check --write src"
	},
	"description": "Reakt Library",
	"main": "build/index.js",
	"module": "build/index.js",
	"types": "build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"import": "./build/index.js",
			"require": "./build/index.cjs"
		}
	},
	"files": [
		"build"
	],
	"keywords": [
		"typescript",
		"library"
	],
	"author": "Alba Martínez Rodríguez",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/albamr/reakt"
	},
	"bugs": {
		"url": "https://github.com/albamr09/reakt/issues"
	},
	"homepage": "https://github.com/albamr/reakt#readme",
	"devDependencies": {
		"@types/node": "^25.0.3",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3"
	}
}
