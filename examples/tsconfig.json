{
  "include": ["src"],
  "compilerOptions": {
    "target": "es2017",
    "module": "es2015",
    "moduleResolution": "node",
    "strict": true,
    "rootDir": "src",
    // Specifies the JSX transform applied to .jsx and .tsx files
    // With "react" it will transform JSX elements into calls to React.createElement()
    "jsx": "react",
    // Specifies the factory function to use when compiling JSX
    "jsxFactory": "ReaKt.createElement"
  }
}
